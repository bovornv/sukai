{
  "name": "sukai-backend",
  "version": "1.0.0",
  "description": "SukAI Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:clean": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true && node src/server.js",
    "dev": "node --watch src/server.js",
    "test:supabase": "node src/config/test-supabase.js",
    "verify:db": "node database/verify-tables.js",
    "cron:notifications": "node src/jobs/notification_sender.js"
  },
  "keywords": [
    "sukai",
    "medical",
    "triage"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.7.0",
    "node-cron": "^3.0.3"
  }
}
